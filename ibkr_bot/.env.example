# Copy to .env and fill in. .env is gitignored -- never commit real secrets.

# --- IB paper account (the gateway logs in with these) ---------------------
TWS_USERID=your_paper_username
TWS_PASSWORD=your_paper_password

# Keep the API read-only (bot only reads market data). 'no' enables orders.
READ_ONLY_API=yes

# Daily gateway restart time (gateway's local tz) and the timezone itself.
AUTO_RESTART_TIME=11:55 PM
TIME_ZONE=America/New_York

# --- Web UI login ----------------------------------------------------------
# Generate both with:   python ui_auth.py
# (prompts for a password, prints the hash + a fresh secret; plaintext is
#  never written to disk). Rotating UI_SECRET logs everyone out.
UI_PASSWORD_HASH=
UI_SECRET=
